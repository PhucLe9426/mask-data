# Local LLM (vLLM chạy trên VM 111)
LOCAL_LLM_URL=http://192.168.210.212:8000/v1/chat/completions
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Public LLM — điền khi đã chọn nhà cung cấp
PUBLIC_LLM_URL=
PUBLIC_LLM_API_KEY=
PUBLIC_LLM_MODEL=

# Timeout gọi API (giây)
REQUEST_TIMEOUT=180

# Thời gian giữ session mapping trong bộ nhớ (giây), mặc định 1 giờ
SESSION_TTL_SECONDS=3600

# PostgreSQL lưu lịch sử hội thoại
DATABASE_URL=postgresql://masking:masking_dev_password@127.0.0.1:5434/masking_app
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=5
